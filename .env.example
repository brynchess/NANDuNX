# Copy to .env and set paths for this one host. Do not commit .env.

# Image tag created by `docker compose build`.
NANDUNX_IMAGE=nandunx-web
NANDUNX_TAG=local

# The service is intentionally loopback-only. Docker uses the host network so
# 127.0.0.1 remains the host's loopback interface; do not change this to a
# LAN address.
NANDUNX_BIND=127.0.0.1:4321

# Private, persistent host directory for temporary browser uploads and the
# redacted current-run log. It needs free space for the uploaded backup.
NANDUNX_STATE_DIR=/var/lib/nandunx-container

# Exactly one whole physical block device to pass through, never a partition.
# Resolve and check it immediately before `docker compose up`; USB /dev/sdX
# names can change after reconnecting a reader.
NANDUNX_DEVICE_PATH=/dev/sdX

# The host mount table is mounted read-only into the container. This preserves
# NANDuNX's mounted-target safety check across the container mount namespace.
NANDUNX_HOST_MOUNTINFO=/proc/1/mountinfo
